# Copy to backend/.env and fill in. backend/.env is gitignored.

# SurrealDB Cloud (or self-hosted) connection
SURREAL_URL=https://your-instance.region.surreal.cloud
SURREAL_NS=your_namespace
SURREAL_DB=your_database
SURREAL_USER=your_user
SURREAL_PASS=your_password

# Google AI Studio key for relationship narration (optional)
GOOGLE_AI_API_KEY=
